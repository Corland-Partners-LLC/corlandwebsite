# Public site URL, used for metadata/sitemap/robots generation
NEXT_PUBLIC_SITE_URL=https://www.corlandpartners.com

# Email delivery for the contact form (see app/api/contact/route.ts).
# Both are required for the contact form to actually send email — without
# them it responds with a clear error rather than a false success.
RESEND_API_KEY=
# The "from" address, used exactly as-is (the route does not wrap it).
# Either a bare address (no-reply@corlandpartners.com) or a display name
# plus address (Leland Ulrich <leland@corlandpartners.com>) — the domain
# must be verified in your Resend account either way.
RESEND_EMAIL_FROM=

# Who contact form submissions are emailed to. Optional — comma-separate
# multiple addresses for more than one recipient. Falls back to
# content/company.ts's `company.email` (the publicly displayed contact
# address) if unset, so the two can be the same or different — e.g. the
# site can display one contact address while submissions actually route
# to whoever currently handles them.
CONTACT_FORM_TO_EMAIL=
