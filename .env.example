# Public site URL, used for metadata/sitemap/robots generation
NEXT_PUBLIC_SITE_URL=https://www.corlandpartners.com

# Email delivery for the contact form (see app/api/contact/route.ts).
# Both are required for the contact form to actually send email — without
# them it responds with a clear error rather than a false success.
RESEND_API_KEY=
# The "from" address, e.g. no-reply@corlandpartners.com — must be on a
# domain verified in your Resend account.
RESEND_EMAIL_FROM=
